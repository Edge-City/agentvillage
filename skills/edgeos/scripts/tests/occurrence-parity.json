    },
    {
      "name": "non-ASCII digit",
      "input": "2026-10-2\u0660T10:00:00Z",
      "sends": null
    },
    {
      "name": "full-width digit",
      "input": "\uff12026-10-21T02:30:00Z",
      "sends": null
    },
    {
      "name": "lower-case t",
      "input": "2026-10-21t02:30:00Z",
      "sends": null
    },
    {
      "name": "lower-case z",
      "input": "2026-10-21T02:30:00z",
      "sends": null
