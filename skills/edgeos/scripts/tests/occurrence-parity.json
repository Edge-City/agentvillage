{
  "about": "EDGEOS-OCCURRENCE parity table: every --occurrence input and the occurrence_start the EdgeOS script sends for it (null = refused, nothing sent). skills/edgeos/scripts/tests/edgeos.test.ts runs it through edgeos.ts occurrenceInstant/parseArgs; plugins/av-events/tests/test_edgeos_occurrence_parity.py runs it through the av-events observer's script_occurrence/http_call. Both must agree on every row.",
  "cases": [
    {
      "name": "EdgeOS's own start_time form, sent byte for byte",
      "input": "2026-10-21T02:30:00Z",
      "sends": "2026-10-21T02:30:00Z"
    },
    {
      "name": "Z without seconds, unchanged",
      "input": "2026-10-21T02:30Z",
      "sends": "2026-10-21T02:30Z"
    },
    {
      "name": "Z with a microsecond fraction, unchanged",
      "input": "2026-10-21T02:30:00.123456Z",
      "sends": "2026-10-21T02:30:00.123456Z"
    },
    {
      "name": "year 0001, Z",
      "input": "0001-01-01T00:00:00Z",
      "sends": "0001-01-01T00:00:00Z"
    },
    {
      "name": "IST offset",
      "input": "2026-10-21T08:00:00+05:30",
      "sends": "2026-10-21T02:30:00Z"
    },
    {
      "name": "IST offset, no seconds",
      "input": "2026-10-21T08:00+05:30",
      "sends": "2026-10-21T02:30:00Z"
    },
    {
      "name": "IST offset, fraction kept",
      "input": "2026-10-21T08:00:00.5+05:30",
      "sends": "2026-10-21T02:30:00.5Z"
    },
    {
      "name": "IST offset, six-digit fraction kept",
      "input": "2026-10-21T08:00:00.123456+05:30",
      "sends": "2026-10-21T02:30:00.123456Z"
    },
    {
      "name": "+00:00",
      "input": "2026-10-21T02:30:00+00:00",
      "sends": "2026-10-21T02:30:00Z"
    },
    {
      "name": "-00:00",
      "input": "2026-10-21T02:30:00-00:00",
      "sends": "2026-10-21T02:30:00Z"
    },
    {
      "name": "negative offset",
      "input": "2026-10-20T21:30:00-05:00",
      "sends": "2026-10-21T02:30:00Z"
    },
    {
      "name": "offset across midnight",
      "input": "2026-10-21T01:00:00+05:30",
      "sends": "2026-10-20T19:30:00Z"
    },
    {
      "name": "+23:59, the largest offset",
      "input": "2026-10-21T00:00:00+23:59",
      "sends": "2026-10-20T00:01:00Z"
    },
    {
      "name": "portal ?occ= of a Z start (encodeURIComponent)",
      "input": "2026-10-21T02%3A30%3A00Z",
      "sends": "2026-10-21T02:30:00Z"
    },
    {
      "name": "portal ?occ= of an offset start",
      "input": "2026-10-21T08%3A00%3A00%2B05%3A30",
      "sends": "2026-10-21T02:30:00Z"
    },
    {
      "name": "lower-case escapes",
      "input": "2026-10-21T02%3a30%3a00Z",
      "sends": "2026-10-21T02:30:00Z"
    },
    {
      "name": "an escaped plain character",
      "input": "2026-10-21T02%3A30%3A0%30Z",
      "sends": "2026-10-21T02:30:00Z"
    },
    {
      "name": "doubly encoded: decoded once only",
