    {
      "name": "encoded, a NUL after it",
      "input": "2026-10-21T02%3A30%3A00Z%00",
      "sends": null
    },
    {
      "name": "a % that starts no escape",
      "input": "2026-10-21T10%ZZ00Z",
      "sends": null
    },
    {
      "name": "a % at the end",
      "input": "2026-10-21T02:30:00Z%",
      "sends": null
    },
    {
