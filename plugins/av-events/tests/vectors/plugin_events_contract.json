    {"type": "plugin.inventory", "note": "bounds: every count 0; hermes_version 'v2026.9.24+local-1' is not data's shape, nulled", "record": {"trigger": "daily", "mode": "off", "expected_loaded": 0, "expected_missing": 0, "bundled_loaded": 0, "unknown_count": 0, "allowed_count": 0, "expected_set_version": "0123456789ab", "hermes_version": "v2026.9.24+local-1"}, "emits": {"trigger": "daily", "mode": "off", "expected_loaded": 0, "expected_missing": 0, "bundled_loaded": 0, "unknown_count": 0, "allowed_count": 0, "expected_set_version": "0123456789ab", "hermes_version": null}},
    {"type": "plugin.inventory", "note": "bounds: every count 10000; hermes_version 'unknown' is not data's shape, nulled", "record": {"trigger": "tick", "mode": "quarantine", "expected_loaded": 10000, "expected_missing": 10000, "bundled_loaded": 10000, "unknown_count": 10000, "allowed_count": 10000, "expected_set_version": "0123456789ab", "hermes_version": "unknown"}, "emits": {"trigger": "tick", "mode": "quarantine", "expected_loaded": 10000, "expected_missing": 10000, "bundled_loaded": 10000, "unknown_count": 10000, "allowed_count": 10000, "expected_set_version": "0123456789ab", "hermes_version": null}},
