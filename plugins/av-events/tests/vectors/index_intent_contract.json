{
  "about": "The overlay's copy of Index's intent contract, copied by hand from indexnetwork/index main (DATA-249). 'rest_writes': the three REST writes record_intention makes (services/api/src/controllers/intent.controller.ts, mounted under /api; body schemas are zod .strict(), so no other key is accepted). 'tools': Index's MCP intent tools (services/api/src/lib/mcp/mcp.tools.ts), which the av-events observer watches when an agent reaches Index's MCP through Hermes's own client. tests/test_index_contract.py holds every HTTP call the overlay builds, the observer's tool names and the agent-facing text to this file; when Index changes, change this file first and let the tests show what else must move.",
  "source": "indexnetwork/index@main services/api/src/controllers/intent.controller.ts, services/api/src/lib/mcp/mcp.tools.ts",
  "verified": "2026-10-03",
  "intent_status_values": ["active", "paused"],
  "rest_writes": {
    "create": {
      "method": "POST",
      "path": "/api/intents",
      "body": {
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": {"type": "string", "maxLength": 65536},
          "preparationReceipt": {"type": "string", "minLength": 1, "maxLength": 65536},
          "networkIds": {"type": "array", "items": {"type": "string"}},
          "sourceType": {"type": ["string", "null"], "maxLength": 1024},
          "sourceId": {"type": ["string", "null"], "maxLength": 1024}
        }
      },
      "success_keys": ["intentId", "networkIds", "sourceType", "sourceId"],
      "error_statuses": [400, 403, 422, 500, 503]
    },
    "update": {
      "method": "PATCH",
      "path": "/api/intents/{id}",
      "body": {
        "additionalProperties": false,
        "required": [],
        "anyOf_required": [["description"], ["sourceType"], ["sourceId"]],
        "properties": {
          "description": {"type": "string", "minLength": 1, "maxLength": 65536},
          "sourceType": {"type": ["string", "null"], "maxLength": 1024},
          "sourceId": {"type": ["string", "null"], "maxLength": 1024}
        }
      },
      "success_keys": ["intentId", "description", "sourceType", "sourceId"],
      "error_statuses": [400, 404, 409, 422]
    },
    "archive": {
      "method": "PATCH",
      "path": "/api/intents/{id}/archive",
      "body": null,
      "success_keys": ["success"],
      "error_statuses": [404]
    }
  },
  "tools": {
    "list_intents": {
      "input": {
        "additionalProperties": false,
        "required": [],
        "properties": {
          "archived": {"type": "boolean"},
          "query": {"type": "string"},
          "page": {"type": "integer", "minimum": 1},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100}
        }
      },
      "result_keys": ["intents", "totalWaitingOpportunities", "pagination"]
    },
    "get_intent": {
      "input": {
        "additionalProperties": false,
        "required": ["intentId"],
        "properties": {"intentId": {"type": "string", "minLength": 1}}
      },
      "result_keys": ["intent"]
    },
    "create_intent": {
      "input": {
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": {"type": "string", "maxLength": 65536},
          "networkIds": {"type": "array", "items": {"type": "string"}},
          "sourceType": {"type": ["string", "null"], "maxLength": 1024},
          "sourceId": {"type": ["string", "null"], "maxLength": 1024}
        }
      },
      "result_keys": ["intentId", "url", "networkIds", "sourceType", "sourceId"]
    },
    "update_intent": {
      "input": {
        "additionalProperties": false,
        "required": ["intentId"],
        "anyOf_required": [["description"], ["sourceType"], ["sourceId"]],
        "properties": {
          "intentId": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1, "maxLength": 65536},
          "sourceType": {"type": ["string", "null"], "maxLength": 1024},
          "sourceId": {"type": ["string", "null"], "maxLength": 1024}
        }
      },
      "result_keys": ["intent"]
    },
    "pause_intent": {
      "input": {
        "additionalProperties": false,
        "required": ["intentId"],
        "properties": {"intentId": {"type": "string", "minLength": 1}}
      },
      "result_keys": ["intentId", "url", "status", "changed"]
    },
    "resume_intent": {
      "input": {
        "additionalProperties": false,
        "required": ["intentId"],
        "properties": {"intentId": {"type": "string", "minLength": 1}}
      },
      "result_keys": ["intentId", "url", "status", "changed"]
    },
    "archive_intent": {
      "input": {
        "additionalProperties": false,
        "required": ["intentId", "confirm"],
        "properties": {
          "intentId": {"type": "string", "minLength": 1},
          "confirm": {"const": true}
        }
      },
      "result_keys": ["intentId", "url", "archived", "message"]
    }
  }
}
