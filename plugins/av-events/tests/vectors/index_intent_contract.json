{
  "about": "The overlay's copy of Index's intent contract, copied by hand from indexnetwork/index main (DATA-249). 'rest_writes': the three REST writes record_intention makes (services/api/src/controllers/intent.controller.ts, mounted under /api; body schemas are zod .strict(), so no other key is accepted). 'tools': Index's MCP intent tools (services/api/src/lib/mcp/mcp.tools.ts), which the av-events observer watches when an agent reaches Index's MCP through Hermes's own client. tests/test_index_contract.py holds every HTTP call the overlay builds, the observer's tool names and the agent-facing text to this file; when Index changes, change this file first and let the tests show what else must move.",
  "source": "indexnetwork/index@main services/api/src/controllers/intent.controller.ts, services/api/src/lib/mcp/mcp.tools.ts",
  "verified": "2026-10-03",
  "error_statuses_note": "Statuses each route can answer besides 2xx: the controller's own, plus 401 from AuthGuard and the 404/409 of resolveId (unknown or ambiguous short id) on the two routes that take an id. Any route can also 5xx through a gateway.",
  "intent_status_values": ["active", "paused"],
  "rest_writes": {
    "create": {
      "method": "POST",
      "path": "/api/intents",
      "body": {
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": {"type": "string", "maxLength": 65536},
          "preparationReceipt": {"type": "string", "minLength": 1, "maxLength": 65536},
          "networkIds": {"type": "array", "items": {"type": "string"}},
          "sourceType": {"type": ["string", "null"], "maxLength": 1024},
          "sourceId": {"type": ["string", "null"], "maxLength": 1024}
        }
      },
      "success_keys": ["intentId", "networkIds", "sourceType", "sourceId"],
      "error_statuses": [400, 401, 403, 422, 500, 503]
    },
    "update": {
      "method": "PATCH",
      "path": "/api/intents/{id}",
      "body": {
        "additionalProperties": false,
        "required": [],
        "anyOf_required": [["description"], ["sourceType"], ["sourceId"]],
        "properties": {
          "description": {"type": "string", "minLength": 1, "maxLength": 65536},
          "sourceType": {"type": ["string", "null"], "maxLength": 1024},
          "sourceId": {"type": ["string", "null"], "maxLength": 1024}
        }
      },
      "success_keys": ["intentId", "description", "sourceType", "sourceId"],
      "error_statuses": [400, 401, 404, 409, 422]
    },
    "archive": {
      "method": "PATCH",
      "path": "/api/intents/{id}/archive",
      "body": null,
      "success_keys": ["success"],
      "error_statuses": [401, 404, 409]
    }
  },
  "hermes_plugin": {
    "about": "DATA-272: Index's own Hermes plugin (indexnetwork/index packages/hermes-plugin), copied by hand from its schemas.py and tools.py as fetched 2026-10-04 (tool_categories_v3 cites commit 168310a for the same tool list; this copy does not claim a commit). Hermes registers a plugin's tools by bare name, so these never carry the mcp__index__ prefix. 'tools': every tool the plugin registers. 'requests': each tool's REST calls in tools.py, as [method, path] with an id path segment written {id}; a tool that makes none has []. 'intent_writes': the input schema of each tool whose request writes an intent (verbatim from schemas.py; neither sets additionalProperties, so a model may send more keys, and the handler reads only the ones it names), with the MCP tool it is observed as. Every handler strips each string it reads and treats an empty or non-string value as absent (_clean_string), and returns its result as one JSON object, a non-2xx answer included. Names, paths and schemas only.",
    "source": "indexnetwork/index packages/hermes-plugin schemas.py, tools.py (as fetched 2026-10-04)",
    "tools": [
      "index_read_intents", "index_create_intent", "index_update_intent", "index_list_intent_networks",
      "index_add_intent_to_network", "index_read_networks", "index_read_network_memberships",
      "index_create_network", "index_update_network", "index_join_network", "index_list_opportunities",
      "index_update_opportunity", "index_research_profile", "index_read_docs", "index_agent_me", "index_open_app"
    ],
    "requests": {
      "index_read_intents": [["GET", "/networks/{id}/intents"], ["POST", "/intents/list"]],
      "index_create_intent": [["POST", "/intents"]],
      "index_update_intent": [["PATCH", "/intents/{id}"]],
      "index_list_intent_networks": [["GET", "/intents/{id}/networks"]],
      "index_add_intent_to_network": [["POST", "/intents/{id}/networks"]],
      "index_read_networks": [["GET", "/networks"]],
      "index_read_network_memberships": [["GET", "/networks/{id}/members"]],
      "index_create_network": [["POST", "/networks"], ["POST", "/network-requests"]],
      "index_update_network": [["PUT", "/networks/{id}"]],
      "index_join_network": [["POST", "/networks/{id}/join"]],
      "index_list_opportunities": [["GET", "/opportunities"]],
      "index_update_opportunity": [["PATCH", "/opportunities/{id}/status"]],
      "index_research_profile": [["POST", "/enrichment/enrich"]],
      "index_read_docs": [["GET", "/docs"]],
      "index_agent_me": [["GET", "/agents/me"]],
      "index_open_app": []
    },
    "intent_writes": {
      "index_create_intent": {
        "observed_as": "create_intent",
        "input": {
          "type": "object",
          "properties": {
            "description": {"type": "string", "description": "What the user is looking for, in their own words."},
            "networkIds": {"type": "array", "items": {"type": "string"}, "description": "Optional network UUIDs to share the signal in."}
          },
          "required": ["description"]
        }
      },
      "index_update_intent": {
        "observed_as": "update_intent",
        "input": {
          "type": "object",
          "properties": {
            "intentId": {"type": "string", "description": "The signal's UUID."},
            "description": {"type": "string", "description": "The rewritten signal text."}
          },
          "required": ["intentId", "description"]
        }
      }
    }
  },
  "tools": {
    "list_intents": {
      "input": {
        "additionalProperties": false,
        "required": [],
        "properties": {
          "archived": {"type": "boolean"},
          "query": {"type": "string"},
          "page": {"type": "integer", "minimum": 1},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100}
        }
      },
      "result_keys": ["intents", "totalWaitingOpportunities", "pagination"]
    },
    "get_intent": {
      "input": {
        "additionalProperties": false,
        "required": ["intentId"],
        "properties": {"intentId": {"type": "string", "minLength": 1}}
      },
      "result_keys": ["intent"]
    },
    "create_intent": {
      "input": {
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": {"type": "string", "maxLength": 65536},
          "networkIds": {"type": "array", "items": {"type": "string"}},
          "sourceType": {"type": ["string", "null"], "maxLength": 1024},
          "sourceId": {"type": ["string", "null"], "maxLength": 1024}
        }
      },
      "result_keys": ["intentId", "url", "networkIds", "sourceType", "sourceId"]
    },
    "update_intent": {
      "input": {
        "additionalProperties": false,
        "required": ["intentId"],
        "anyOf_required": [["description"], ["sourceType"], ["sourceId"]],
        "properties": {
          "intentId": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1, "maxLength": 65536},
          "sourceType": {"type": ["string", "null"], "maxLength": 1024},
          "sourceId": {"type": ["string", "null"], "maxLength": 1024}
        }
      },
      "result_keys": ["intent"]
    },
    "pause_intent": {
      "input": {
        "additionalProperties": false,
        "required": ["intentId"],
        "properties": {"intentId": {"type": "string", "minLength": 1}}
      },
      "result_keys": ["intentId", "url", "status", "changed"]
    },
    "resume_intent": {
      "input": {
        "additionalProperties": false,
        "required": ["intentId"],
        "properties": {"intentId": {"type": "string", "minLength": 1}}
      },
      "result_keys": ["intentId", "url", "status", "changed"]
    },
    "archive_intent": {
      "input": {
        "additionalProperties": false,
        "required": ["intentId", "confirm"],
        "properties": {
          "intentId": {"type": "string", "minLength": 1},
          "confirm": {"const": true}
        }
      },
      "result_keys": ["intentId", "url", "archived", "message"]
    }
  }
}
