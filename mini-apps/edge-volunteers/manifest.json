          "topic": {
            "enum": [
              "planning",
              "cover",
              "hours",
              "requests",
              "labels",
              "shifts",
              "limits",
              "changes"
            ]
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "enum": [
                "planning",
                "cover",
                "hours",
                "requests",
                "labels",
                "shifts",
                "limits",
                "changes"
