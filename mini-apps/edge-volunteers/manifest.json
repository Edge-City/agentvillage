{
  "manifest": 2,
  "id": "edge-volunteers",
  "name": "Edge City Volunteers",
  "version": "1.0.0",
  "description": "See your own Edge City volunteer shifts, hours and plan, the open shifts you could claim and your cover requests. Ask for scheduling changes in chat; each one is made only after you say yes to its summary.",
  "homepage": "https://edge-city-volunteers.vercel.app/",
  "owner": {
    "github": "Nhajela",
    "org": "Edge City Volunteers"
  },
  "visibility": "sandbox",
  "permissions": [
    {
      "kind": "read",
      "label": "Read your schedule and hours",
      "description": "Your own shifts (coming and past), this week's hours, your plan for the next days, the open shifts you could claim and your own cover requests. The data comes from Edge City Volunteers, which receives your Telegram user id with each request so it knows who you are."
    },
    {
      "kind": "action",
      "label": "Make scheduling changes you approve",
      "description": "Claim an open shift, move or open one of your shifts for cover, cancel a cover request, mark a rest day, plan your free hours and ranked shifts, or take extra shifts on or off. Each change is checked first and made only after you say yes in this chat. Edge City Volunteers receives your Telegram user id and your requests."
    }
  ],
  "service": {
    "kind": "mcp",
    "baseUrl": "https://edge-city-volunteers.vercel.app/api/mcp",
    "auth": {
      "mode": "app-token",
      "secretRef": "MINI_APP_EDGE_VOLUNTEERS_TOKEN"
    }
  },
  "operations": [
