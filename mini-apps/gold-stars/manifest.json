{
  "manifest": 2,
  "id": "gold-stars",
  "name": "Gold Stars",
  "version": "1.1.0",
  "description": "Recognize someone in your village with a Gold Star.",
  "homepage": "https://agents.edgecity.live",
  "visibility": "everyone",
  "staff": true,
  "permissions": [
    {
      "kind": "read",
      "label": "Find recipients and check stars",
      "description": "Search the village directory, read your quota and draft status, read your own Skylight status, and send your own Skylight picture to your own chat when you ask."
    },
    {
      "kind": "action",
      "label": "Prepare and send Gold Stars",
      "description": "Prepare, send or cancel your exact draft, and mark or undo a Rolodex meeting when you ask. Sent when you ask; a card only if your own settings ask first."
    },
    {
      "kind": "read",
      "label": "Look up a resident's public profile",
      "description": "Read what another resident does, their public and village context and their social profile links. Never their email, phone, Telegram handle or private notes."
    }
  ],
  "service": {
    "kind": "internal"
  },
  "operations": [
    {
      "name": "rolodex.search",
      "class": "read",
      "maxRequestBytes": 4096,
      "maxResponseBytes": 262144,
      "timeoutMs": 25000,
      "framing": "data"
    },
    {
      "name": "gold-stars.quota",
      "class": "read",
      "maxRequestBytes": 4096,
      "maxResponseBytes": 262144,
      "timeoutMs": 25000,
      "framing": "data"
    },
    {
      "name": "gold-stars.prepare",
      "class": "prepare",
      "maxRequestBytes": 4096,
      "maxResponseBytes": 262144,
      "timeoutMs": 25000,
      "framing": "data"
    },
    {
      "name": "gold-stars.send",
      "class": "needs-card",
      "maxRequestBytes": 4096,
      "maxResponseBytes": 262144,
      "timeoutMs": 60000,
      "framing": "data",
      "approval": {
        "prepare": "gold-stars.prepare"
      }
    },
    {
      "name": "gold-stars.status",
      "class": "read",
      "maxRequestBytes": 4096,
      "maxResponseBytes": 262144,
      "timeoutMs": 25000,
      "framing": "data"
    },
    {
      "name": "gold-stars.cancel",
      "class": "write",
      "maxRequestBytes": 4096,
      "maxResponseBytes": 262144,
      "timeoutMs": 25000,
      "framing": "data"
    },
    {
      "name": "rolodex.meeting",
      "class": "write",
      "maxRequestBytes": 4096,
      "maxResponseBytes": 262144,
      "timeoutMs": 25000,
      "framing": "data"
    },
    {
      "name": "skylight.status",
      "class": "read",
      "maxRequestBytes": 4096,
      "maxResponseBytes": 262144,
      "timeoutMs": 25000,
      "framing": "data"
    },
    {
      "name": "rolodex.person",
      "class": "read",
      "maxRequestBytes": 4096,
      "maxResponseBytes": 65536,
      "timeoutMs": 25000,
      "framing": "data"
    }
  ],
  "skills": [
    {
      "name": "gold-stars",
      "version": "1.1.2",
      "sha256": "ca855cf0f49752ec3206b476daeea1f04cc6c2cad08de62c0fa88a349ed36c18",
      "path": "skills/gold-stars/SKILL.md"
    }
  ],
  "legacy": {
    "prefixes": [
      "rolodex",
      "skylight"
    ],
    "personOnly": {
      "operations": [
        "rolodex.person"
      ],
      "permissions": [
        "Look up a resident's public profile"
      ]
    }
  }
}
