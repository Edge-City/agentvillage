{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Village mini-app manifest v2",
  "description": "One reviewed mini-app (MINIAPPS-PLATFORM-v2-design.md section 1.1). Closed: a key not named here is refused.",
  "type": "object",
  "required": [
    "manifest",
    "id",
    "name",
    "version",
    "description",
    "homepage",
    "visibility",
    "permissions",
    "service",
    "operations",
    "skills"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(-[0-9A-Za-z][0-9A-Za-z.-]{0,31})?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://[^\\s]{1,2040}$"
    },
    "owner": {
      "type": "object",
      "required": [
        "github"
      ],
      "additionalProperties": false,
      "properties": {
        "github": {
          "anyOf": [
            {
              "$ref": "#/$defs/login"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/login"
              }
            }
          ]
        },
        "org": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^\\S(.*\\S)?$"
        }
      }
    },
    "credit": {
      "type": "object",
      "required": [
        "role",
        "attendeeId",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "app",
            "product"
          ]
        },
        "attendeeId": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^\\S(.*\\S)?$"
        }
      }
    },
    "visibility": {
      "enum": [
        "sandbox",
        "admins",
        "everyone"
      ]
    },
    "staff": {
      "description": "Comes with every agent: kept installed, never removable (cp catalog staff: true). Absent means false.",
      "type": "boolean"
    },
    "listed": {
      "description": "false keeps a reviewed app off every install and discovery surface. Absent means true.",
      "type": "boolean"
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "label",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "read",
              "action"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "mcp",
            "https-json",
            "internal",
            "none"
          ]
        },
        "baseUrl": {
          "type": "string",
          "pattern": "^https://[^\\s]{1,2040}$"
        },
        "auth": {
          "type": "object",
          "required": [
            "mode"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "none",
                "oauth",
                "app-token"
              ]
            },
            "oauth": {
              "type": "object",
              "required": [
                "resource",
                "scopes",
                "discovery"
              ],
              "additionalProperties": false,
              "properties": {
                "resource": {
                  "type": "string",
                  "pattern": "^https://[^\\s]{1,2040}$"
                },
                "scopes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_:.-]{1,64}$"
                  }
                },
                "discovery": {
                  "type": "string",
                  "pattern": "^https://[^\\s]{1,2040}$"
                }
              }
            },
            "secretRef": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
            }
          }
        }
      }
    },
    "operations": {
      "description": "At least one, except for service kind none (a context-only app), which has none: the validator checks it, by kind.",
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": "object",
          "required": [
            "maxEntries"
          ],
          "additionalProperties": false,
          "properties": {
            "maxEntries": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "ceiling": {
              "enum": [
                "private",
                "village",
                "public"
              ]
            }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "sha256",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "version": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(-[0-9A-Za-z][0-9A-Za-z.-]{0,31})?$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^skills/[a-z][a-z0-9-]{0,63}/SKILL\\.md$"
          }
        }
      }
    },
    "events": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "maxLength": 120,
        "pattern": "^miniapp\\.[a-z0-9][a-z0-9-]{0,39}\\.[a-z][a-z0-9_.-]{0,63}@[1-9][0-9]{0,3}$"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 16,
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]{0,63}$"
        },
        "additionalProperties": {
          "enum": [
            "string",
            "integer",
            "boolean"
          ]
        }
      }
    },
    "legacy": {
      "description": "Phase 0 only: what the v1 entry needs and v2 does not model. Retires with the signed projection.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "const": "first-party-reviewed-external"
        },
        "prefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
          }
        },
        "personOnly": {
          "type": "object",
          "required": [
            "operations",
            "permissions"
          ],
          "additionalProperties": false,
          "properties": {
            "operations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*){1,3}$"
              }
            },
            "permissions": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "login": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
    },
    "operation": {
      "type": "object",
      "required": [
        "name",
        "class"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*){1,3}$"
        },
        "class": {
          "enum": [
            "read",
            "write",
            "prepare",
            "needs-card"
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "tool"
              ],
              "additionalProperties": false,
              "properties": {
                "tool": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,79}$"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "method",
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "method": {
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ]
                },
                "path": {
                  "type": "string",
                  "pattern": "^/[A-Za-z0-9/_.-]{0,199}$"
                }
              }
            }
          ]
        },
        "input": {
          "type": "object"
        },
        "maxRequestBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 26214400
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "framing": {
          "enum": [
            "data",
            "media"
          ]
        },
        "returns": {
          "type": "object",
          "required": [
            "draftIdPath",
            "previewPath",
            "previewMaxBytes",
            "previewTtlSeconds"
          ],
          "additionalProperties": false,
          "properties": {
            "draftIdPath": {
              "$ref": "#/$defs/jsonPath"
            },
            "previewPath": {
              "$ref": "#/$defs/jsonPath"
            },
            "previewMaxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "previewTtlSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          }
        },
        "approval": {
          "type": "object",
          "required": [
            "prepare"
          ],
          "additionalProperties": false,
          "properties": {
            "prepare": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*){1,3}$"
            },
            "summary": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "summaryMaxBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3000
            }
          }
        }
      }
    },
    "jsonPath": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^\\$(\\.[A-Za-z_][A-Za-z0-9_]{0,63}){1,8}$"
    }
  }
}
