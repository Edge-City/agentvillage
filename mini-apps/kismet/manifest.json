    {
      "name": "kismet.signup",
      "class": "write",
      "target": {
        "tool": "kismet_signup"
      },
      "input": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "status": {
                "type": "string",
                "enum": [
                  "single",
                  "relationship",
                  "married",
                  "complicated",
                  "undisclosed"
                ]
              },
              "openness": {
                "type": "string",
                "enum": [
                  "mono",
                  "poly",
                  "open",
                  "unsure",
                  "undisclosed"
                ]
              },
              "lookingFor": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "romance",
                    "friends",
                    "collaborators",
                    "cofounder",
                    "adventure",
                    "vibes"
                  ]
                }
              },
              "gender": {
                "type": "string",
                "enum": [
                  "man",
                  "woman",
                  "nonbinary"
                ]
              },
              "interestedIn": {
                "type": "string",
                "enum": [
                  "men",
                  "women",
                  "everyone"
                ]
              },
              "interests": {
                "type": "array",
                "minItems": 3,
                "maxItems": 15,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 30
                }
              },
              "about": {
                "type": "string",
                "maxLength": 160
              },
              "availability": {
                "type": "string",
                "enum": [
                  "weekday_evenings",
                  "weekends",
                  "flexible"
                ]
              },
              "area": {
                "type": "string",
                "maxLength": 40
              },
              "telegram": {
                "type": "string",
                "pattern": "^@?[A-Za-z0-9_]{4,32}$"
              },
              "agentProfile": {
                "type": "string",
                "maxLength": 1500
              },
              "agreedToTerms": {
                "type": "boolean",
                "const": true
              },
              "ageConfirmed": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "name",
              "lookingFor",
              "interests",
              "agreedToTerms",
              "ageConfirmed"
