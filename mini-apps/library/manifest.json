{
  "manifest": 2,
  "id": "library",
  "name": "Edge Library",
  "version": "1.0.0",
  "description": "Search and read the Edge City India 2026 village knowledge graph: the people, projects, tools and topics of the village, linked to the sources they came from, with the history of every change. Read only: your agent cannot add to or change Edge Library from Agent Village.",
  "homepage": "https://library.positivesumexperiments.com/",
  "credit": {
    "role": "product",
    "attendeeId": "bfa34a9f-c163-4477-baf8-e878d2653bf6",
    "name": "Naman Hajela"
  },
  "owner": {
    "github": "Nhajela",
    "org": "Edge Library"
  },
  "visibility": "sandbox",
  "permissions": [
    {
      "kind": "read",
      "label": "Search and read the village knowledge graph",
      "description": "Your searches and the nodes, sources, history and proposals you open in Edge Library (library.positivesumexperiments.com). Agent Village tells Edge Library which resident you are by a private, stable reference, never your Telegram id or username. Reading does not create a member entry for you in Edge Library. Edge Library keeps search words without who asked."
    }
  ],
  "service": {
    "kind": "mcp",
    "baseUrl": "https://library.positivesumexperiments.com/api/mcp",
    "auth": {
      "mode": "app-token",
      "secretRef": "MINI_APP_LIBRARY_KEY"
    }
  },
  "operations": [
    {
      "name": "library.initialize",
      "class": "read",
      "target": {
        "tool": "library_initialize"
      },
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "maxRequestBytes": 4096,
      "maxResponseBytes": 262144,
      "timeoutMs": 25000,
      "framing": "data"
    },
    {
      "name": "library.search",
      "class": "read",
      "target": {
        "tool": "library_search"
      },
      "input": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "types": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "node",
                "passage",
                "edge"
              ]
            }
          },
          "how": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "quoted",
                "said_by",
                "inferred",
                "confirmed"
              ]
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      },
      "maxRequestBytes": 4096,
      "maxResponseBytes": 262144,
      "timeoutMs": 25000,
      "framing": "data"
    },
    {
      "name": "library.get",
      "class": "read",
      "target": {
        "tool": "library_get"
      },
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "historyLimit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "queryId": {
            "type": "string",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "additionalProperties": false
      },
      "maxRequestBytes": 4096,
      "maxResponseBytes": 262144,
      "timeoutMs": 25000,
      "framing": "data"
    },
    {
      "name": "library.source",
      "class": "read",
      "target": {
        "tool": "library_source"
      },
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50000
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "maxRequestBytes": 4096,
      "maxResponseBytes": 262144,
      "timeoutMs": 25000,
      "framing": "data"
    },
    {
      "name": "library.schema",
      "class": "read",
      "target": {
        "tool": "library_schema"
      },
      "input": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "maxRequestBytes": 4096,
      "maxResponseBytes": 262144,
      "timeoutMs": 25000,
      "framing": "data"
    },
    {
      "name": "library.history",
      "class": "read",
      "target": {
        "tool": "library_history"
      },
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "entity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "entityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "additionalProperties": false
      },
      "maxRequestBytes": 4096,
      "maxResponseBytes": 262144,
      "timeoutMs": 25000,
      "framing": "data"
    },
    {
      "name": "library.changes_since",
      "class": "read",
      "target": {
        "tool": "library_changes_since"
      },
      "input": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        },
        "required": [
          "seq"
        ],
        "additionalProperties": false
      },
      "maxRequestBytes": 4096,
      "maxResponseBytes": 262144,
      "timeoutMs": 25000,
      "framing": "data"
    },
    {
      "name": "library.proposals",
      "class": "read",
      "target": {
        "tool": "library_proposals"
      },
      "input": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "withdrawn"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "additionalProperties": false
      },
      "maxRequestBytes": 4096,
      "maxResponseBytes": 262144,
      "timeoutMs": 25000,
      "framing": "data"
    }
  ],
  "skills": [
    {
      "name": "library",
      "version": "1.0.0",
      "sha256": "7ac599c8ff1f6099d4e8bd8d27916625a87db0adec6efaaa6196915fd62b26e7",
      "path": "skills/library/SKILL.md"
    }
  ]
}
